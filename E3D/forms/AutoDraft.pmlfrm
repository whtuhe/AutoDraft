-- File:            AutoDraft.pmlfrm
--   Type:          Form Definition
--   Group:         Application
--     Keyword:     AutoDraft
--   Module:        DESIGN
--
-- Author:          Shing Liu(eryar@163.com)
-- Created:         2026-06-28  12:36
--
-- Description:     Automatic piping layout drawing generation for AVEVA PDMS/E3D.
--
-------------------------------------------------------------------------------
setup form !!AutoDraft dialog
    title 'AutoDraft'
    
    option .optDwg 'DWG Type' width 18
    list .listZone at xmin ymax width 28 height 12
    
    button .btnCreateZone 'Create' at xmin ymax pixmap width 16 height 16 tooltip 'Create DWG Zone'
    button .btnModifyZone 'Modify' pixmap width 16 height 16 tooltip 'Modify DWG Zone'
    button .btnDeleteZone 'Delete' pixmap width 16 height 16 tooltip 'Delete DWG Zone'
    
    list .listDwg at xmin.optDwg ymax+0.2 width 28 height 18
    
    button .btnCreateDwg 'Create' at xmin.optDwg ymax pixmap width 16 height 16 tooltip 'Create Drawing'
    button .btnModifyDwg 'Modify' pixmap width 16 height 16 tooltip 'Modify Drawing'
    button .btnDeleteDwg 'Delete' pixmap width 16 height 16 'Delete Drawing'
    button .btnCopyDwg 'Copy' pixmap width 16 height 16 tooltip 'Copy Drawing'
    button .btnOpenDwg 'Open' pixmap width 16 height 16 tooltip 'Open Drawing'
    
    frame .frmViewport 'Viewport' at xmax.optDwg+1 ymin.optDwg
        list .listViewport width 18 height 4
        text .textViewName 'Name ' width 10 is string
        option .optDir 'Direction' width 8
        option .optScale 'Scale' at xmin.textViewName ymax width 8 
        text .textPosition 'Position ' width 10 is string
        
        button .btnCreateView 'Create' at xmin.textViewName ymax+0.2 pixmap width 16 height 16 tooltip 'Create Viewport'
        button .btnModifyView 'Modify' pixmap width 16 height 16 tooltip 'Modify Viewport'
        button .btnDeleteView 'Delete' pixmap width 16 height 16 tooltip 'Delete Viewport'
    exit
    
    frame .frmDrawlist 'Drawlist' at xmin.frmViewport ymax
        list .listPipeline width 28 height 16
        list .listReference width 28 height 16
        
        button .btnIncPipe 'Inc' at xmin.listPipeline ymax pixmap width 16 height 16 callback '!this.incPipeline()'
        button .btnExcPipe 'Exc' pixmap width 16 height 16 callback '!this.excPipeline()'
        button .btnDelPipe 'Delete' pixmap width 16 height 16
        
        button .btnIncRef 'Inc' at xmin.listReference pixmap width 16 height 16 callback '!this.incReference()'
        button .btnExcRef 'Exc' pixmap width 16 height 16 callback '!this.excReference()'
        button .btnDelRef 'Delete' pixmap width 16 height 16
    exit
    
    frame .frmGrid 'Grid' at xmin.frmViewport ymax width 63
        option .optGrid 'Grid' width 40
        button .btnAddGrid 'Add' pixmap width 16 height 16
        button .btnDelGrid 'Delete' pixmap width 16 height 16
    exit
    
    frame .frmLimits 'Limits' at xmin.frmViewport ymax width 63
        numericinput .numX1 'E1' range -100000 100000 STEP 5 value 0 width 10
        numericinput .numY1 'N1' range -100000 100000 STEP 5 value 0 width 10
        numericinput .numZ1 'U1' range -100000 100000 STEP 5 value 0 width 10
        
        button .btnPickPoint1 '.' pixmap width 16 height 16
        button .btnCeBox '.' pixmap width 16 height 16
        button .btnShowBox '' pixmap width 16 height 16
        
        numericinput .numX2 'E2' at xmin.numX1 ymax+0.2 range -100000 100000 STEP 5 value 0 width 10
        numericinput .numY2 'N2' range -100000 100000 STEP 5 value 0 width 10
        numericinput .numZ2 'U2' range -100000 100000 STEP 5 value 0 width 10
        
        button .btnPickPoint2 '.' pixmap width 16 height 16
        button .btn3dBox '|' pixmap width 16 height 16
        button .btnClip '' pixmap width 16 height 16
    exit
    
    button .btnGenerateDwg 'Generate' at xmax.frmLimits-size ymax background 5 pixmap width 24 height 24
    button .btnBatchGenerate 'Batch' at xmin.btnGenerateDwg-size background 3 pixmap width 24 height 24
exit
-------------------------------------------------------------------------------
--
-- Method:      AutoDraft()
--
-- Description: constructor.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------------
define method .AutoDraft()

    !aCreateIcon = !!pml.getPathName('createelement16.png')
    !aModifyIcon = !!pml.getPathName('modify16.png')
    !aDeleteIcon = !!pml.getPathName('deletece16.png')
    !aCopyIcon = !!pml.getPathName('planecopy16.png')
    !aOpenIcon = !!pml.getPathName('fileopen16.png')
    !aAddIcon = !!pml.getPathName('addce16.png')
    !aRemoveIcon = !!pml.getPathName('removece16.png')
    !aCheckIcon = !!pml.getPathName('valid16x16.png')
    
    !aPickIcon = !!pml.getPathName('navigate16.png')
    !aBoxIcon1 = !!pml.getPathName('3d-2d16.png')
    !aBoxIcon2 = !!pml.getPathName('2d-3d16.png')
    
    !aBoxIcon = !!pml.getPathName('box.png')
    !aClipIcon = !!pml.getPathName('clipce16.png')
    
    !aPrintIcon = !!pml.getPathName('reports24.png')
    !aBatchIcon = !!pml.getPathName('print24.png')
    
    !this.btnCreateZone.addPixmap(!aCreateIcon)
    !this.btnModifyZone.addPixmap(!aModifyIcon)
    !this.btnDeleteZone.addPixmap(!aDeleteIcon)
    
    !this.btnCreateDwg.addPixmap(!aCreateIcon)
    !this.btnModifyDwg.addPixmap(!aModifyIcon)
    !this.btnDeleteDwg.addPixmap(!aDeleteIcon)
    !this.btnCopyDwg.addPixmap(!aCopyIcon)
    !this.btnOpenDwg.addPixmap(!aOpenIcon)
    
    !this.btnCreateView.addPixmap(!aCreateIcon)
    !this.btnModifyView.addPixmap(!aModifyIcon)
    !this.btnDeleteView.addPixmap(!aDeleteIcon)
    
    !this.btnIncPipe.addPixmap(!aAddIcon)
    !this.btnExcPipe.addPixmap(!aRemoveIcon)
    !this.btnDelPipe.addPixmap(!aDeleteIcon)
    
    !this.btnIncRef.addPixmap(!aAddIcon)
    !this.btnExcRef.addPixmap(!aRemoveIcon)
    !this.btnDelRef.addPixmap(!aDeleteIcon)
    
    !this.btnAddGrid.addPixmap(!aAddIcon)
    !this.btnDelGrid.addPixmap(!aRemoveIcon)
    
    !this.btnPickPoint1.addPixmap(!aPickIcon)
    !this.btnPickPoint2.addPixmap(!aPickIcon)
    
    !this.btnCeBox.addPixmap(!aBoxIcon1)
    !this.btn3dBox.addPixmap(!aBoxIcon2)
    
    !this.btnShowBox.addPixmap(!aBoxIcon)
    !this.btnClip.addPixmap(!aClipIcon)
    
    !this.btnGenerateDwg.addPixmap(!aPrintIcon)
    !this.btnBatchGenerate.addPixmap(!aBatchIcon)

    !this.optDwg.add('Piping layout drawing')
    !this.listZone.setHeadings('DWG Zone')
    !this.listDwg.setHeadings('DWG List')
    
    !aHeadings = array()
    !aHeadings.append('Status')
    !aHeadings.append('Pipeline')
    !this.listPipeline.setHeadings(!aHeadings)
    
    !aHeadings.clear()
    !aHeadings.append('Status')
    !aHeadings.append('Reference')
    !this.listReference.setHeadings(!aHeadings)
    
    !this.listZone.add('ZONE-001')
    !this.listZone.add('ZONE-002')
    !this.listZone.add('ZONE-003')
    
    !this.listDwg.add('DWG-001')
    !this.listDwg.add('DWG-002')
    !this.listDwg.add('DWG-003')
    
    !this.listViewport.add('V1')
    !this.listViewport.add('V2')
    
    !this.optDir.add('DOWN')
    !this.optDir.add('UP')
    
    !this.optScale.add('1/10')
    !this.optScale.add('1/20')
    !this.optScale.add('1/50')
    !this.optScale.add('1/100')
endmethod
-------------------------------------------------------------------------------
--
-- Method:      incPipeline()
--
-- Description: Include pipeline to the list.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------------
define method .incPipeline()
    !aRow = '+	' + !!ce.name
    !this.listPipeline.add(!aRow)
endmethod
-------------------------------------------------------------------------------
--
-- Method:      excPipeline()
--
-- Description: Exclude pipeline to the list.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------------
define method .excPipeline()
    !aRow = '-	' + !!ce.name
    !this.listPipeline.add(!aRow)
endmethod
-------------------------------------------------------------------------------
--
-- Method:      incReference()
--
-- Description: Include reference to the list.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------------
define method .incReference()
    !aRow = '+	' + !!ce.name
    !this.listReference.add(!aRow)
endmethod
-------------------------------------------------------------------------------
--
-- Method:      excReference()
--
-- Description: Exclude reference to the list.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------------
define method .excReference()
    !aRow = '-	' + !!ce.name
    !this.listReference.add(!aRow)
endmethod
-------------------------------------------------------------------------------
